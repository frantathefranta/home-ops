{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "switch-congestion",
  "title": "Switches · Traffic and Congestion",
  "description": "SNMP IF-MIB switch traffic, packet rates, link utilization, errors and discards. See Reading congestion for workflow and sampling limitations.",
  "tags": [
    "network",
    "snmp",
    "switches"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "switch",
        "label": "Switch",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(up{job=\"snmp-exporter-switches\"}, instance)",
          "refId": "switch"
        },
        "definition": "label_values(up{job=\"snmp-exporter-switches\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "interface",
        "label": "Interface",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(ifIndex{job=\"snmp-exporter-switches\",instance=~\"${switch:regex}\"}, ifName)",
          "refId": "interface"
        },
        "definition": "label_values(ifIndex{job=\"snmp-exporter-switches\",instance=~\"${switch:regex}\"}, ifName)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Reading congestion",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Start with all switches**, zoom into the incident, then select the busiest switch/port. Legends include the port alias; click a legend to isolate it. **TX/RX are relative to the switch port.**\n\nCompare utilization with discards (possible queue pressure), errors (possible link faults), and broadcast/multicast packets (possible storms). High utilization alone does not prove congestion. Top-10 membership can change over time. Byte totals cover the selected time range.\n\nRates use the last two scrapes (`irate`), at the existing **1-minute scrape resolution**. Sub-minute microbursts are not visible. Failed scrapes can leave the previous rate visible until the lookback window expires; check scrape health first. Missing data is not zero traffic. Unknown/zero link speeds are omitted from utilization. Physical ports and LAGs can overlap: do not add them as a network-wide total. SNMP does not identify source hosts/flows; use sFlow/packet capture for that."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SNMP scrape health — each switch",
      "description": "0 means the most recent scrape failed; no data means the target is absent/stale. This does not prove the switch itself is down.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (instance) (up{job=\"snmp-exporter-switches\",instance=~\"${switch:regex}\"})",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "SCRAPE FAILED",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "No samples"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Top 10 TX port utilization",
      "description": "Percent of advertised ifHighSpeed (Mbps), separately per direction for full-duplex links. Unknown/zero speed is excluded. One-minute sampled peaks, not queue occupancy.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "interval": "1m",
      "maxDataPoints": 1500,
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, 100 * 8 * max by (instance, ifIndex, ifName, ifAlias) (irate(ifHCOutOctets{job=\"snmp-exporter-switches\",instance=~\"${switch:regex}\",ifName=~\"${interface:regex}\"}[$__rate_interval])) / on (instance, ifIndex) group_left ( ) (1000000 * (max by (instance, ifIndex) (ifHighSpeed{job=\"snmp-exporter-switches\",instance=~\"${switch:regex}\",ifName=~\"${interface:regex}\"}) > 0)))",
          "legendFormat": "{{instance}} · {{ifName}} {{ifAlias}}",
          "instant": false,
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisLabel": "",
            "axisPlacement": "auto",
            "axisSoftMax": 100,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "max",
            "lastNotNull"
          ]
        }
      }
    },
