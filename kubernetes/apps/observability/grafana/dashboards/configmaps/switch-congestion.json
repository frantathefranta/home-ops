    {
      "id": 11,
      "type": "timeseries",
      "title": "Interface discards/s — TX and RX",
      "description": "Discarded packets without detected errors. TX discards can indicate egress queue pressure, but may also reflect policy or other resource limits. All selected ports, not only the top ten.",
