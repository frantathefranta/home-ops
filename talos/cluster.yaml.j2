---
version: v1alpha1
machine:
  ca:
    crt: op://kubernetes/talos/MACHINE_CA_CRT
  # talconfig: additionalMachineCertSans
  certSANs:
    - 10.33.40.25
    - talos-maxi.franta.us
    - 127.0.0.1
  features:
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
    kubePrism:
      enabled: true
      port: 7445
    rbac: true
  token: op://kubernetes/talos/MACHINE_TOKEN
  # v1alpha1 kubelet block: typed KubeletConfig conflicts with this, but only
  # the v1alpha1 form carries extraMounts + nodeIP (both required by talconfig).
  kubelet:
    image: ghcr.io/siderolabs/kubelet:v1.36.4
    defaultRuntimeSeccompProfileEnabled: true
    disableManifestsDirectory: true
    extraConfig:
      maxParallelImagePulls: 10
      maxPods: 400
      serializeImagePulls: false
    nodeIP:
      validSubnets:
        - 10.33.35.0/27
        - "${CLUSTER_NODE_V6_CIDR}"
    extraMounts:
      - destination: /var/openebs/local
        type: bind
        source: /var/openebs/local
        options:
          - bind
          - rshared
          - rw
  # talconfig: topology.kubernetes.io/region (all nodes)
  nodeLabels:
    topology.kubernetes.io/region: talos-maxi
  files:
    - op: overwrite
      path: /etc/nfsmount.conf
      permissions: 0o644
      content: |
        [ NFSMount_Global_Options ]
        nfsvers=4.2
        hard=True
        nconnect=8
        noatime=True
        rsize=1048576
        wsize=1048576
cluster:
  ca:
    crt: op://kubernetes/talos/CLUSTER_CA_CRT
  clusterName: talos-maxi
  controlPlane:
    endpoint: https://10.33.40.25:6443
  discovery:
    registries:
      kubernetes:
        disabled: true
      service:
        disabled: false
  id: op://kubernetes/talos/CLUSTER_ID
  network:
    cni:
      name: none
    dnsDomain: cluster.local
    podSubnets:
      - 10.69.0.0/16
      - "${CLUSTER_POD_V6_CIDR}"
    serviceSubnets:
      - 10.96.0.0/16
      - "${CLUSTER_SVC_V6_CIDR}"
  secret: op://kubernetes/talos/CLUSTER_SECRET
  token: op://kubernetes/talos/CLUSTER_TOKEN
---
apiVersion: v1alpha1
kind: ResolverConfig
searchDomains:
  domains: []
hostDNS:
  enabled: true
  forwardKubeDNSToHost: false
  resolveMemberNames: true
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: factory.talos.dev/{{ install_type }}/{{ schematic }}:v1.13.10
provisioning:
  # CP default (talconfig installDisk: /dev/sda); workers override per-node.
  diskSelector:
    match: disk.name == "sda"
  wipe: false
---
apiVersion: v1alpha1
kind: WatchdogTimerConfig
device: /dev/watchdog0
timeout: 5m
---
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: containerd
content: |
  [plugins."io.containerd.cri.v1.images"]
    discard_unpacked_layers = false
  [plugins."io.containerd.cri.v1.runtime"]
    device_ownership_from_security_context = true
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
  fs.inotify.max_queued_events: "65536"
  fs.inotify.max_user_instances: "8192"
  fs.inotify.max_user_watches: "524288"
  net.core.bpf_jit_harden: "1"
  net.core.default_qdisc: fq
  net.core.rmem_max: "67108864"
  net.core.wmem_max: "67108864"
  net.ipv4.tcp_congestion_control: bbr
  net.ipv4.tcp_fastopen: "3"
  net.ipv6.conf.all.accept_ra: "0"
  net.ipv6.conf.all.forwarding: "1"
  net.ipv6.conf.bond0.accept_ra: "2"
  vm.nr_hugepages: "1024"
---
apiVersion: v1alpha1
kind: KernelModuleConfig
name: nbd