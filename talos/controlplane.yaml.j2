# -*- mode: yaml -*-
---
version: v1alpha1
machine:
  type: controlplane
  ca:
    crt: op://kubernetes/talos/MACHINE_CA_CRT
    key: op://kubernetes/talos/MACHINE_CA_KEY
cluster:
  # Keep the CA material in v1alpha1 form: these 1Password fields are
  # base64-encoded PEM, while the 1.14 CA documents require literal PEM.
  # ca merges as a cert+key unit, so repeat crt alongside key.
  ca:
    crt: op://kubernetes/talos/CLUSTER_CA_CRT
    key: op://kubernetes/talos/CLUSTER_CA_KEY
  aggregatorCA:
    crt: op://kubernetes/talos/CLUSTER_AGGREGATORCA_CRT
    key: op://kubernetes/talos/CLUSTER_AGGREGATORCA_KEY
  # talconfig: allowSchedulingOnControlPlanes. Still v1alpha1 in 1.14: the
  # KubeNodeConfig replacement expresses CP scheduling through the node's
  # taints instead of a flag. This cluster carries no KubeNodeConfig docs
  # (see kubelet block in cluster.yaml.j2), so the flag stays as-is.
  allowSchedulingOnControlPlanes: true
  etcd:
    advertisedSubnets:
      - 10.33.35.0/27
    ca:
      crt: op://kubernetes/talos/CLUSTER_ETCD_CA_CRT
      key: op://kubernetes/talos/CLUSTER_ETCD_CA_KEY
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
---
apiVersion: v1alpha1
kind: KubeServiceAccountConfig
issuer:
  # The render pipeline decodes this base64-encoded PEM value for the document.
  privateKey: op://kubernetes/talos/CLUSTER_SERVICEACCOUNT_KEY
  issuerURL: https://10.33.40.25:6443
---
apiVersion: v1alpha1
# was: cluster.secretboxEncryptionSecret
kind: KubeEtcdEncryptionConfig
config:
  resources:
    - providers:
        - secretbox:
            keys:
              - name: key1
                secret: op://kubernetes/talos/CLUSTER_SECRETBOXENCRYPTIONSECRET
        - identity: {}
      resources:
        - secrets
---
apiVersion: v1alpha1
# Restrict anonymous API access to the health endpoints (1.14 doc's canonical
# example; replaces the implicit k8s default of anonymous everywhere).
kind: KubeAuthenticationConfig
configuration:
  anonymous:
    conditions:
      - path: /livez
      - path: /readyz
      - path: /healthz
    enabled: true
  jwt: []
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
image: registry.k8s.io/kube-apiserver:v1.37.1
# talconfig: additionalApiServerCertSans
certExtraSANs:
  - 10.33.40.25
  - talos-maxi.franta.us
  - 127.0.0.1
extraArgs:
  enable-aggregator-routing: "true"
---
apiVersion: v1alpha1
kind: KubeAuditPolicyConfig
configuration:
  apiVersion: audit.k8s.io/v1
  kind: Policy
  rules:
    - level: Metadata
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
image: registry.k8s.io/kube-controller-manager:v1.37.1
extraArgs:
  bind-address: 0.0.0.0
# node-cidr-mask-size-ipv6 moved to KubeNetworkConfig (cluster.yaml.j2)
---
apiVersion: v1alpha1
kind: KubeCoreDNSConfig
enabled: false
---
apiVersion: v1alpha1
kind: KubeProxyConfig
image: registry.k8s.io/kube-proxy:v1.37.0
enabled: false
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
image: registry.k8s.io/kube-scheduler:v1.37.0
config:
  profiles:
    - schedulerName: default-scheduler
      plugins:
        score:
          disabled:
            - name: ImageLocality
      pluginConfig:
        - name: PodTopologySpread
          args:
            defaultingType: List
            defaultConstraints:
              - maxSkew: 1
                topologyKey: kubernetes.io/hostname
                whenUnsatisfiable: ScheduleAnyway
extraArgs:
  bind-address: 0.0.0.0
---
apiVersion: v1alpha1
kind: KubeTalosAPIAccessConfig
allowedRoles:
  - os:admin
allowedKubernetesNamespaces:
  - actions-runner-system
  - system-upgrade
